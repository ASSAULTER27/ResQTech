# ResQTech Environment Configuration Template
# For Vercel deployment, add these variables in your Vercel Project Settings -> Environment Variables.

# Supabase Project URL (Found in Supabase Dashboard > Project Settings > API)
SUPABASE_URL=https://your-supabase-project.supabase.co

# Supabase Publishable / Anon Key (Found in Supabase Dashboard > Project Settings > API)
# SAFE FOR FRONTEND USE. DO NOT USE THE SERVICE_ROLE KEY HERE!
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key

# Render Deployed Backend API URL (FastAPI)
# This project is a static frontend, so Vercel will only use this variable if
# your deployment injects it into window.ENV. The source fallback is the same URL.
VITE_API_URL=https://resqtech-k5xd.onrender.com
